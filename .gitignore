# macOS / Xcode
.DS_Store
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
docs/.build

# Generated Xcode projects (regenerate with `xcodegen` in each apps/* dir)
apps/*/*.xcodeproj
apps/*/project.local.yml

# SwiftPM
.swiftpm/
.build/

# Model artifacts — downloaded/converted weights are NEVER committed
models/cache
models/*.mlmodel
models/*.mlpackage
models/*.mlmodelc
models/*.onnx
models/*.pt

# Python
scripts/.venv/
__pycache__/
*.pyc

# Server
server/.build/
server/.env
*.sqlite
*.db

# Secrets — never commit any of these
.env
*.p8
*.p12
*.mobileprovision
**/Secrets*.plist
**/GoogleService-Info.plist

# Evaluation corpus images (licensed per eval/manifest.json; may show civilian plates)
eval/corpus
eval/results/

# Your own test photos (unknown licence) - never committed
eval/user
training/
eval/degraded
eval/feeds
# Local-data links (never commit: absolute symlinks to a dev machine's data replace real directories on checkout)
/eval/corpus
/eval/user
/models/cache

# Packaged release artifacts (staged locally, published to GitHub Releases)
models/release/
